{
  "type": "object",
  "description": "Ausgelesener Beleg (Prompt-Version extract-v1). Nicht sicher Lesbares: null bzw. leerer Text und ein Hinweis unter warnings – nie raten.",
  "properties": {
    "document_type": {
      "type": "string",
      "enum": ["rechnung", "quittung", "gutschrift", "kassenbon", "mahnung", "lieferschein", "sonstiges"]
    },
    "direction": {
      "type": "string",
      "enum": ["ausgabe", "einnahme"],
      "description": "ausgabe = der Verein zahlt, einnahme = der Verein erhält Geld"
    },
    "supplier": {
      "type": "object",
      "description": "Aussteller des Belegs; unbekannte Angaben als leerer Text",
      "properties": {
        "name": { "type": "string" },
        "address": { "type": "string" },
        "iban": { "type": "string" },
        "bic": { "type": "string" },
        "vat_id": { "type": "string", "description": "USt-IdNr." },
        "tax_number": { "type": "string", "description": "Steuernummer" },
        "email": { "type": "string" },
        "website": { "type": "string" },
        "creditor_id": { "type": "string", "description": "Gläubiger-ID (SEPA-Lastschrift)" }
      },
      "required": ["name", "address", "iban", "bic", "vat_id", "tax_number", "email", "website", "creditor_id"],
      "additionalProperties": false
    },
    "invoice_number": { "type": "string" },
    "customer_number": { "type": "string" },
    "contract_number": { "type": "string" },
    "invoice_date": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "description": "Belegdatum JJJJ-MM-TT, null wenn nicht lesbar"
    },
    "due_date": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "service_period": {
      "type": "object",
      "properties": {
        "from": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "to": { "type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
      },
      "required": ["from", "to"],
      "additionalProperties": false
    },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$", "description": "ISO 4217, z. B. EUR" },
    "total_gross": {
      "type": ["string", "null"],
      "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$",
      "description": "Bruttobetrag mit Punkt als Dezimaltrennzeichen, ohne Tausenderpunkte, z. B. 1234.56; null wenn nicht lesbar"
    },
    "total_net": { "type": ["string", "null"], "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$" },
    "taxes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "rate": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,2})?$", "description": "Steuersatz in Prozent, z. B. 19" },
          "amount": { "type": "string", "pattern": "^-?[0-9]+(\\.[0-9]{1,2})?$" }
        },
        "required": ["rate", "amount"],
        "additionalProperties": false
      }
    },
    "payment": {
      "type": "object",
      "properties": {
        "already_paid": { "type": "boolean" },
        "method": { "type": "string", "enum": ["bar", "karte", "lastschrift", "ueberweisung", "paypal", "unbekannt"] },
        "mandate_reference": { "type": "string" }
      },
      "required": ["already_paid", "method", "mandate_reference"],
      "additionalProperties": false
    },
    "purpose_short": { "type": "string", "description": "Ein Satz: worum geht es (für Vereinszwecke)" },
    "category_id": { "type": ["integer", "null"] },
    "sphere": {
      "type": ["string", "null"],
      "enum": ["ideell", "vermoegensverwaltung", "zweckbetrieb", "wirtschaftlich", null],
      "description": "nur wenn Sphären aktiv sind, sonst null"
    },
    "cost_center_id": { "type": ["integer", "null"] },
    "recurring": {
      "type": "object",
      "properties": {
        "likely": { "type": "boolean" },
        "period": { "type": ["string", "null"], "enum": ["monat", "quartal", "halbjahr", "jahr", null] },
        "evidence": { "type": "string" }
      },
      "required": ["likely", "period", "evidence"],
      "additionalProperties": false
    },
    "confidence": {
      "type": "object",
      "properties": {
        "supplier": { "type": "number", "minimum": 0, "maximum": 1 },
        "total_gross": { "type": "number", "minimum": 0, "maximum": 1 },
        "invoice_date": { "type": "number", "minimum": 0, "maximum": 1 },
        "category": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "required": ["supplier", "total_gross", "invoice_date", "category"],
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "required": [
    "document_type", "direction", "supplier", "invoice_number", "customer_number", "contract_number",
    "invoice_date", "due_date", "service_period", "currency", "total_gross", "total_net", "taxes",
    "payment", "purpose_short", "category_id", "sphere", "cost_center_id", "recurring", "confidence", "warnings"
  ],
  "additionalProperties": false
}
